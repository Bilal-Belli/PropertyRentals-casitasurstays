<%- include('partials/header') %>
<div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-2"><%= property.title %></h1>
    <p class="text-gray-600 mb-4"><%= property.location %></p>

    <div class="rounded-2xl overflow-hidden shadow-md mb-8 h-96">
        <img src="/uploads/<%= property.image %>" alt="<%= property.title %>" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800'">
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-2">
            <h2 class="text-xl font-bold mb-2">About this place</h2>
            <p class="text-gray-700 leading-relaxed mb-6"><%= property.description %></p>

            <h3 class="text-lg font-bold mb-2">Unavailable Calendar Dates</h3>
            <div class="bg-gray-100 p-4 rounded-lg text-sm text-gray-700 mb-6">
                <% if (property.unavailableDates && property.unavailableDates.length > 0) { %>
                    <ul class="list-disc list-inside">
                        <% property.unavailableDates.forEach(date => { %>
                            <li><%= date %></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p>No booked/unavailable dates currently.</p>
                <% } %>
            </div>

            <!-- Contact Host Form -->
            <div class="bg-white border border-gray-200 p-6 rounded-xl shadow-sm">
                <h3 class="font-bold text-lg mb-3">Contact Host</h3>
                <form action="/property/<%= property.id %>/message" method="POST">
                    <textarea name="message" rows="3" placeholder="Ask the host a question..." required class="w-full border border-gray-300 rounded-lg p-3 text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-rose-500"></textarea>
                    <button type="submit" class="bg-gray-900 hover:bg-black text-white text-sm font-semibold px-4 py-2 rounded-lg">Send Message</button>
                </form>
            </div>
        </div>

        <!-- Reservation Box -->
        <div class="bg-white border border-gray-200 p-6 rounded-xl shadow-md h-fit">
            <div class="text-xl font-bold mb-4">$<%= property.price %> <span class="text-sm font-normal text-gray-500">night</span></div>
            <form action="/property/<%= property.id %>/reserve" method="POST">
                <div class="mb-3">
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Check-in</label>
                    <input type="date" name="checkIn" required class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                </div>
                <div class="mb-4">
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Check-out</label>
                    <input type="date" name="checkOut" required class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                </div>
                <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-3 rounded-lg text-sm transition">Request Reservation</button>
            </form>
        </div>
    </div>
</div>
<%- include('partials/footer') %>