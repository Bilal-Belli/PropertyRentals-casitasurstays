<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb Mini</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Global Custom Thin Scrollbar matching the webapp style */
        html {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f8fafc;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
    <nav class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center shadow-sm relative z-50">
        <a href="/" class="text-rose-500 font-bold text-xl tracking-wide">casitasurstays</a>
        
        <!-- Desktop Navigation Links -->
        <div class="hidden md:flex items-center gap-2">
            <% if (currentUser) { %>
                <span class="text-sm font-medium text-gray-600 hidden lg:inline mr-2">Hello, <%= currentUser.name %> (<%= currentUser.role %>)</span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Public View</a>
                    <a href="/admin" onclick="event.preventDefault(); if(typeof switchTab === 'function') { switchTab(null, 'properties'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Properties</a>
                    <a href="/admin" onclick="event.preventDefault(); if(typeof switchTab === 'function') { switchTab(null, 'messages'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Messages</a>
                    <a href="/admin" onclick="event.preventDefault(); if(typeof switchTab === 'function') { switchTab(null, 'reservations'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Reservations</a>
                    <a href="/admin" onclick="event.preventDefault(); if(typeof switchTab === 'function') { switchTab(null, 'users'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Users</a>
                    <a href="/logout" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200 transition">Logout</a>
                <% } else { %>
                    <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Properties</a>
                    <a href="/user/dashboard" onclick="event.preventDefault(); if(typeof switchUserTab === 'function') { switchUserTab(null, 'user-reservations'); } else { window.location.href='/user/dashboard'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Reservations</a>
                    <a href="/user/dashboard" onclick="event.preventDefault(); if(typeof switchUserTab === 'function') { switchUserTab(null, 'user-messages'); } else { window.location.href='/user/dashboard#messages'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Messages</a>
                    <a href="/logout" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200 transition">Logout</a>
                <% } %>
            <% } else { %>
                <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Properties</a>
                <a href="/contact" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Contact Us</a>
                <a href="/login" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-3 py-1.5 rounded-full transition">Log in</a>
                <a href="/register" class="bg-rose-500 hover:bg-rose-600 text-white px-4 py-2 rounded-full text-sm font-semibold transition">Sign up</a>
            <% } %>
        </div>

        <!-- Mobile Hamburger Toggle Button -->
        <div class="md:hidden flex items-center">
            <button onclick="toggleMobileMenu()" class="text-gray-700 hover:text-rose-500 focus:outline-none p-2 rounded-lg border border-gray-200">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Dropdown Menu Drawer -->
    <div id="mobileMenu" class="hidden md:hidden bg-white border-b border-gray-200 px-6 py-4 flex flex-col gap-3 shadow-lg absolute top-16 left-0 right-0 z-40">
        <% if (currentUser) { %>
            <div class="text-xs font-semibold text-gray-500 pb-2 border-b border-gray-100">Hello, <%= currentUser.name %> (<%= currentUser.role %>)</div>
            <% if (currentUser.role === 'admin') { %>
                <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Public View</a>
                <a href="/admin" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchTab === 'function') { switchTab(null, 'properties'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Properties</a>
                <a href="/admin" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchTab === 'function') { switchTab(null, 'messages'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Messages</a>
                <a href="/admin" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchTab === 'function') { switchTab(null, 'reservations'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Reservations</a>
                <a href="/admin" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchTab === 'function') { switchTab(null, 'users'); } else { window.location.href='/admin'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Users</a>
                <a href="/logout" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-xl text-sm font-semibold text-center border border-gray-200">Logout</a>
            <% } else { %>
                <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Properties</a>
                <a href="/user/dashboard" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchUserTab === 'function') { switchUserTab(null, 'user-reservations'); } else { window.location.href='/user/dashboard'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Reservations</a>
                <a href="/user/dashboard" onclick="event.preventDefault(); toggleMobileMenu(); if(typeof switchUserTab === 'function') { switchUserTab(null, 'user-messages'); } else { window.location.href='/user/dashboard#messages'; }" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Messages</a>
                <a href="/logout" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-xl text-sm font-semibold text-center border border-gray-200">Logout</a>
            <% } %>
        <% } else { %>
            <a href="/" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Properties</a>
            <a href="/contact" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Contact Us</a>
            <a href="/login" class="text-sm font-semibold border border-gray-200 hover:border-rose-500 hover:text-rose-500 px-4 py-2 rounded-xl transition">Log in</a>
            <a href="/register" class="bg-rose-500 text-white px-4 py-2 rounded-xl text-sm font-semibold text-center">Sign up</a>
        <% } %>
    </div>

    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }
    </script>
    <main class="flex-grow">