<%- include('partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-bold">Admin Portal</h1>
        <a href="/admin/property/add" class="bg-rose-500 hover:bg-rose-600 text-white px-4 py-2 rounded-lg text-sm font-semibold">Add New Property</a>
    </div>

    <!-- Properties Management -->
    <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">Properties Management</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% properties.forEach(prop => { %>
                <div class="bg-white border border-gray-200 p-4 rounded-xl shadow-sm flex flex-col gap-4">
                    <div class="flex gap-4 items-center">
                        <img src="/uploads/<%= prop.image %>" class="w-20 h-20 rounded-lg object-cover" onerror="this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=200'">
                        <div>
                            <h3 class="font-bold text-base"><%= prop.title %></h3>
                            <p class="text-gray-500 text-sm"><%= prop.location %> - $<%= prop.price %>/night</p>
                            <a href="/admin/property/edit/<%= prop.id %>" class="text-rose-500 text-xs font-semibold hover:underline inline-block mt-1">Edit Property Info</a>
                        </div>
                    </div>

                    <!-- Edit Calendar Form -->
                    <form action="/admin/property/calendar/<%= prop.id %>" method="POST" class="bg-gray-50 p-3 rounded-lg border border-gray-200">
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Unavailable Calendar Dates (comma separated YYYY-MM-DD)</label>
                        <div class="flex gap-2">
                            <input type="text" name="unavailableDates" value="<%= prop.unavailableDates ? prop.unavailableDates.join(', ') : '' %>" placeholder="2026-10-01, 2026-10-02" class="flex-grow border border-gray-300 rounded p-1.5 text-xs">
                            <button type="submit" class="bg-gray-900 text-white px-3 py-1.5 rounded text-xs font-semibold">Update Calendar</button>
                        </div>
                    </form>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- Reservations -->
    <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">Reservation Requests</h2>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
            <% if (reservations.length === 0) { %>
                <p class="p-6 text-gray-500 text-sm">No reservations received.</p>
            <% } else { %>
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-gray-600">
                            <th class="p-4">User</th>
                            <th class="p-4">Property ID</th>
                            <th class="p-4">Dates</th>
                            <th class="p-4">Status</th>
                            <th class="p-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reservations.forEach(resv => { %>
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="p-4 font-semibold"><%= resv.userName %></td>
                                <td class="p-4 text-gray-600"><%= resv.propertyId %></td>
                                <td class="p-4 text-gray-600"><%= resv.checkIn %> to <%= resv.checkOut %></td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold 
                                        <%= resv.status === 'Accepted' ? 'bg-green-100 text-green-700' : resv.status === 'Declined' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                                        <%= resv.status %>
                                    </span>
                                </td>
                                <td class="p-4 flex gap-2">
                                    <form action="/admin/reservation/<%= resv.id %>/accept" method="POST">
                                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs font-semibold">Accept</button>
                                    </form>
                                    <form action="/admin/reservation/<%= resv.id %>/decline" method="POST">
                                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs font-semibold">Decline</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </section>

    <!-- Messages & Clients -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <section>
            <h2 class="text-xl font-bold mb-4">Client Messages</h2>
            <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm space-y-4">
                <% if (messages.length === 0) { %>
                    <p class="text-gray-500 text-sm">No messages received.</p>
                <% } else { %>
                    <% messages.forEach(msg => { %>
                        <div class="border-b border-gray-100 pb-3 last:border-0">
                            <p class="text-xs font-semibold text-rose-500"><%= msg.userName %> (Property ID: <%= msg.propertyId %>)</p>
                            <p class="text-sm text-gray-700 mt-1"><%= msg.message %></p>
                            <span class="text-[10px] text-gray-400"><%= new Date(msg.date).toLocaleString() %></span>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>

        <section>
            <h2 class="text-xl font-bold mb-4">Registered Clients</h2>
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-gray-600">
                            <th class="p-3">Name</th>
                            <th class="p-3">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr class="border-b border-gray-100">
                                <td class="p-3 font-medium"><%= u.name %></td>
                                <td class="p-3 text-gray-600"><%= u.email %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
<%- include('partials/footer') %>