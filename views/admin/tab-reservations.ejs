<div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm w-full p-6">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h3 class="font-bold text-base text-gray-900">Reservation Requests</h3>
            <p class="text-xs text-gray-500">Manage booking statuses, add confidential internal notes, and process requests.</p>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-gray-600 text-xs uppercase tracking-wider">
                    <th class="p-3">User</th>
                    <th class="p-3">Property ID</th>
                    <th class="p-3">Dates</th>
                    <th class="p-3">Status</th>
                    <th class="p-3">Admin Notes</th>
                    <th class="p-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="reservationsTableBody">
                <!-- Dynamically populated via pagination JS -->
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls Footer -->
    <div class="flex justify-between items-center pt-4 mt-4 border-t border-gray-100 text-xs text-gray-600">
        <span id="resPaginationInfo">Showing 0-0 of 0 requests</span>
        <div class="flex gap-2">
            <button type="button" id="resPrevBtn" onclick="changeResPage(-1)" class="px-3 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-40 disabled:cursor-not-allowed">Previous</button>
            <button type="button" id="resNextBtn" onclick="changeResPage(1)" class="px-3 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
        </div>
    </div>
</div>

<script>
    const rawReservationsData = <%- JSON.stringify(reservations || []) %>;
    let currentResPage = 1;
    const resPerPage = 20;

    function renderReservationsTable() {
        const tbody = document.getElementById('reservationsTableBody');
        tbody.innerHTML = '';

        const totalResv = rawReservationsData.length;
        if (totalResv === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-gray-400 text-xs">No reservation requests received.</td></tr>`;
            document.getElementById('resPaginationInfo').textContent = `Showing 0-0 of 0 requests`;
            document.getElementById('resPrevBtn').disabled = true;
            document.getElementById('resNextBtn').disabled = true;
            return;
        }

        const totalPages = Math.ceil(totalResv / resPerPage);
        if (currentResPage > totalPages) currentResPage = totalPages;
        if (currentResPage < 1) currentResPage = 1;

        const startIdx = (currentResPage - 1) * resPerPage;
        const endIdx = Math.min(startIdx + resPerPage, totalResv);
        const pageItems = rawReservationsData.slice(startIdx, endIdx);

        pageItems.forEach(resv => {
            const tr = document.createElement('tr');
            tr.className = "border-b border-gray-100 hover:bg-gray-50 transition text-xs";
            
            const badgeColor = resv.status === 'Accepted' ? 'bg-green-100 text-green-700' : resv.status === 'Declined' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700';

            tr.innerHTML = `
                <td class="p-3 font-semibold text-gray-900">${escapeHtml(resv.userName || 'Guest')}</td>
                <td class="p-3 text-gray-600">${escapeHtml(resv.propertyId || '-')}</td>
                <td class="p-3 text-gray-600">${escapeHtml(resv.checkIn)} &rarr; ${escapeHtml(resv.checkOut)}</td>
                <td class="p-3">
                    <select onchange="updateReservationStatus('${resv.id}', this.value)" class="border border-gray-200 rounded-lg px-2 py-1 text-xs font-semibold ${badgeColor} focus:outline-none cursor-pointer">
                        <option value="Pending" ${resv.status === 'Pending' ? 'selected' : ''}>Pending</option>
                        <option value="Accepted" ${resv.status === 'Accepted' ? 'selected' : ''}>Accepted</option>
                        <option value="Declined" ${resv.status === 'Declined' ? 'selected' : ''}>Declined</option>
                    </select>
                </td>
                <td class="p-3">
                    <input type="text" value="${escapeHtml(resv.note || '')}" placeholder="Add note..." oninput="saveReservationNote('${resv.id}', this)" class="w-full border border-gray-200 rounded-lg px-2 py-1 text-xs bg-gray-50/50 focus:bg-white focus:border-rose-500 focus:outline-none transition">
                </td>
                <td class="p-3 text-right">
                    <form action="/admin/reservation/${resv.id}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this reservation request?');" class="inline">
                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg font-semibold transition">Delete</button>
                    </form>
                </td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('resPaginationInfo').textContent = `Showing ${startIdx + 1}-${endIdx} of ${totalResv} requests (Page ${currentResPage} of ${totalPages || 1})`;
        document.getElementById('resPrevBtn').disabled = currentResPage === 1;
        document.getElementById('resNextBtn').disabled = currentResPage >= totalPages;
    }

    function changeResPage(direction) {
        currentResPage += direction;
        renderReservationsTable();
    }

    function updateReservationStatus(id, newStatus) {
        fetch(`/admin/reservation/${id}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const target = rawReservationsData.find(r => r.id === id);
                if (target) target.status = newStatus;
                renderReservationsTable();
            }
        })
        .catch(err => console.error('Error updating status:', err));
    }

    // Debounced real-time note saver
    let noteTimeouts = {};
    function saveReservationNote(id, inputEl) {
        clearTimeout(noteTimeouts[id]);
        const noteText = inputEl.value;
        
        noteTimeouts[id] = setTimeout(() => {
            fetch(`/admin/reservation/${id}/note`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ note: noteText })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const target = rawReservationsData.find(r => r.id === id);
                    if (target) target.note = noteText;
                }
            })
            .catch(err => console.error('Error saving note:', err));
        }, 500);
    }

    document.addEventListener("DOMContentLoaded", () => {
        renderReservationsTable();
    });

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
</script>