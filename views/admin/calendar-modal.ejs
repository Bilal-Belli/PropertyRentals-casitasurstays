<div id="calendarModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl relative">
        <div class="flex justify-between items-center mb-6 pb-2 border-b border-gray-100">
            <div>
                <h3 id="modalPropertyTitle" class="text-lg font-bold text-gray-900">Manage Calendar</h3>
                <p class="text-xs text-gray-500">Click dates to block or unblock availability</p>
            </div>
            <button onclick="window.closeCalendarModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold bg-gray-100 hover:bg-gray-200 rounded-full w-8 h-8 flex items-center justify-center transition">&times;</button>
        </div>

        <form id="calendarForm" method="POST">
            <input type="hidden" id="unavailableDatesInput" name="unavailableDates">

            <div class="flex justify-between items-center mb-4 px-2">
                <button type="button" onclick="window.changeMonth(-1)" class="p-2 hover:bg-gray-100 rounded-full transition text-gray-700 font-bold">&#8249;</button>
                <h4 id="calendarMonthYearLabel" class="text-sm font-bold text-gray-800"></h4>
                <button type="button" onclick="window.changeMonth(1)" class="p-2 hover:bg-gray-100 rounded-full transition text-gray-700 font-bold">&#8250;</button>
            </div>

            <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-400 mb-2">
                <div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
            </div>

            <div id="nativeCalendarGrid" class="grid grid-cols-7 gap-1 text-center text-sm mb-6"></div>

            <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                <button type="button" onclick="window.clearAllBlockedDates()" class="text-xs font-semibold text-rose-500 hover:underline">Clear all blocked</button>
                <div class="flex gap-2">
                    <button type="button" onclick="window.closeCalendarModal()" class="px-4 py-2 rounded-xl text-xs font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-rose-500 hover:bg-rose-600 text-white transition">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>