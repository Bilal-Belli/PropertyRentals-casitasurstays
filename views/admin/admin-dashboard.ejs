<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-6 md:py-8">
    <!-- Tab 1: Properties Management -->
    <div id="properties" class="tab-content">
        <%- include('tab-properties') %>
    </div>

    <!-- Tab 2: Messages -->
    <div id="messages" class="tab-content hidden">
        <%- include('tab-messages') %>
    </div>

    <!-- Tab 3: Reservation Requests -->
    <div id="reservations" class="tab-content hidden">
        <%- include('tab-reservations') %>
    </div>

    <!-- Tab 4: Registered Users -->
    <div id="users" class="tab-content hidden">
        <%- include('tab-users') %>
    </div>
</div>

<!-- Airbnb-Style Native Interactive Calendar Modal Partial -->
<%- include('calendar-modal') %>

<!-- Embed all conversation stack data securely -->
<script>
    let allConversationsData = <%- JSON.stringify((typeof messages !== 'undefined' && messages) ? messages : []) %>;
    let activeConversationId = null;
</script>

<script>
    function switchTab(evt, tabId) {
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        const targetTab = document.getElementById(tabId);
        if (targetTab) {
            targetTab.classList.remove('hidden');
        }

        localStorage.setItem('activeAdminTab', tabId);

        // If switching to messages tab, auto-select first conversation
        if (tabId === 'messages') {
            const firstChat = document.querySelector('.conversation-item');
            if (firstChat && !activeConversationId) {
                selectConversation(firstChat.getAttribute('data-conversation'));
            }
        }
    }

    // Restore active tab and chat selection on page load
    document.addEventListener("DOMContentLoaded", () => {
        const savedTab = localStorage.getItem('activeAdminTab');
        if (savedTab && document.getElementById(savedTab)) {
            switchTab(null, savedTab);
        }

        const firstChat = document.querySelector('.conversation-item');
        if (firstChat) {
            selectConversation(firstChat.getAttribute('data-conversation'));
        }
    });

    // Real-time Drag-and-Drop Reordering Logic
    const listContainer = document.getElementById('properties-list');
    if (listContainer) {
        let draggedRow = null;

        listContainer.addEventListener('dragstart', (e) => {
            draggedRow = e.target.closest('.property-row');
            if (draggedRow) setTimeout(() => draggedRow.classList.add('opacity-40'), 0);
        });

        listContainer.addEventListener('dragend', () => {
            if (draggedRow) draggedRow.classList.remove('opacity-40');
            draggedRow = null;
            saveNewOrder();
        });

        listContainer.addEventListener('dragover', (e) => {
            e.preventDefault();
            const afterElement = getDragAfterElement(listContainer, e.clientY);
            const currentItem = document.querySelector('.opacity-40');
            if (currentItem) {
                if (afterElement == null) {
                    listContainer.appendChild(currentItem);
                } else {
                    listContainer.insertBefore(currentItem, afterElement);
                }
            }
        });

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.property-row:not(.opacity-40)')];
            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        function saveNewOrder() {
            const rows = document.querySelectorAll('.property-row');
            const order = Array.from(rows).map(row => row.getAttribute('data-id'));

            fetch('/admin/properties/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const status = document.getElementById('reorder-status');
                    status.textContent = '✓ Order saved successfully';
                    setTimeout(() => { status.textContent = ''; }, 2000);
                }
            })
            .catch(err => console.error('Error saving order:', err));
        }
    }

    // Native Airbnb Range Selection & Unchecking Controller Logic
    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();
    let blockedDatesSet = new Set();
    let rangeStartDate = null;

    window.openCalendarModal = function(propertyId, propertyTitle, unavailableDatesStr) {
        document.getElementById('modalPropertyTitle').textContent = `Calendar: ${propertyTitle}`;
        document.getElementById('calendarForm').action = `/admin/property/calendar/${propertyId}`;
        
        blockedDatesSet.clear();
        rangeStartDate = null;
        if (unavailableDatesStr) {
            unavailableDatesStr.split(',').map(d => d.trim()).filter(Boolean).forEach(d => blockedDatesSet.add(d));
        }

        const now = new Date();
        currentYear = now.getFullYear();
        currentMonth = now.getMonth();

        renderNativeCalendar();
        document.getElementById('calendarModal').classList.remove('hidden');
    }

    window.closeCalendarModal = function() {
        document.getElementById('calendarModal').classList.add('hidden');
    }

    window.changeMonth = function(direction) {
        currentMonth += direction;
        if (currentMonth > 11) {
            currentMonth = 0;
            currentYear++;
        } else if (currentMonth < 0) {
            currentMonth = 11;
            currentYear--;
        }
        renderNativeCalendar();
    }

    function renderNativeCalendar() {
        const gridEl = document.getElementById('nativeCalendarGrid');
        const labelEl = document.getElementById('calendarMonthYearLabel');
        if (!gridEl || !labelEl) return;
        gridEl.innerHTML = '';

        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        labelEl.textContent = `${monthNames[currentMonth]} ${currentYear}`;

        const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
        const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

        for (let i = 0; i < firstDayIndex; i++) {
            gridEl.appendChild(document.createElement('div'));
        }

        for (let day = 1; day <= totalDays; day++) {
            const formattedMonth = String(currentMonth + 1).padStart(2, '0');
            const formattedDay = String(day).padStart(2, '0');
            const dateStr = `${currentYear}-${formattedMonth}-${formattedDay}`;

            const dayBtn = document.createElement('button');
            dayBtn.type = 'button';
            dayBtn.textContent = day;
            dayBtn.className = "h-9 w-9 mx-auto flex items-center justify-center rounded-full text-xs font-semibold transition ";

            const isBlocked = blockedDatesSet.has(dateStr);
            const isRangeStart = rangeStartDate === dateStr;

            if (isRangeStart) {
                dayBtn.className += "bg-rose-700 text-white ring-2 ring-rose-300 shadow-md";
            } else if (isBlocked) {
                dayBtn.className += "bg-rose-500 text-white shadow-sm hover:bg-rose-600";
            } else {
                dayBtn.className += "text-gray-700 hover:bg-gray-100";
            }

            dayBtn.onclick = () => {
                if (!rangeStartDate) {
                    rangeStartDate = dateStr;
                } else {
                    let start = new Date(rangeStartDate);
                    let end = new Date(dateStr);

                    if (start > end) {
                        [start, end] = [end, start];
                    }

                    let allBlocked = true;
                    let tempCurr = new Date(start);
                    let datesInRange = [];
                    while (tempCurr <= end) {
                        let dStr = tempCurr.toISOString().split('T')[0];
                        datesInRange.push(dStr);
                        if (!blockedDatesSet.has(dStr)) {
                            allBlocked = false;
                        }
                        tempCurr.setDate(tempCurr.getDate() + 1);
                    }

                    datesInRange.forEach(dStr => {
                        if (allBlocked) {
                            blockedDatesSet.delete(dStr);
                        } else {
                            blockedDatesSet.add(dStr);
                        }
                    });

                    rangeStartDate = null;
                }
                const inputEl = document.getElementById('unavailableDatesInput');
                if (inputEl) inputEl.value = Array.from(blockedDatesSet).sort().join(', ');
                renderNativeCalendar();
            };

            gridEl.appendChild(dayBtn);
        }

        const inputEl = document.getElementById('unavailableDatesInput');
        if (inputEl) inputEl.value = Array.from(blockedDatesSet).sort().join(', ');
    }

    window.clearAllBlockedDates = function() {
        blockedDatesSet.clear();
        rangeStartDate = null;
        renderNativeCalendar();
    }
</script>

<%- include('../partials/footer') %>