<div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm w-full p-6">
    <!-- Search Bar & Counter Header -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h3 class="font-bold text-base text-gray-900">Registered Users Management</h3>
            <p class="text-xs text-gray-500">Manage client accounts, view statistics, and search records.</p>
        </div>
        <div class="w-full sm:w-72">
            <input type="text" id="userSearchInput" oninput="filterAndPaginateUsers()" placeholder="Search by name, email, phone..." class="w-full border border-gray-300 rounded-xl px-4 py-2 text-xs focus:outline-none focus:border-rose-500">
        </div>
    </div>

    <!-- Users Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-gray-600 text-xs uppercase tracking-wider">
                    <th class="p-3">First Name</th>
                    <th class="p-3">Last Name</th>
                    <th class="p-3">Email</th>
                    <th class="p-3">Phone</th>
                    <th class="p-3 text-center">Reservations</th>
                    <th class="p-3 text-center">Conversations</th>
                    <th class="p-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                <!-- Populated dynamically via JS -->
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls Footer -->
    <div class="flex justify-between items-center pt-4 mt-4 border-t border-gray-100 text-xs text-gray-600">
        <span id="paginationInfo">Showing 0-0 of 0 users</span>
        <div class="flex gap-2">
            <button type="button" id="prevPageBtn" onclick="changeUserPage(-1)" class="px-3 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-40 disabled:cursor-not-allowed">Previous</button>
            <button type="button" id="nextPageBtn" onclick="changeUserPage(1)" class="px-3 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
        </div>
    </div>
</div>

<script>
    const rawUsersData = <%- JSON.stringify(users || []) %>;
    let currentUserPage = 1;
    const usersPerPage = 20;
    let filteredUsers = [...rawUsersData];

    function filterAndPaginateUsers() {
        const query = document.getElementById('userSearchInput').value.toLowerCase().trim();
        
        filteredUsers = rawUsersData.filter(u => {
            const fName = (u.firstName || '').toLowerCase();
            const lName = (u.lastName || '').toLowerCase();
            const fullName = (u.name || '').toLowerCase();
            const email = (u.email || '').toLowerCase();
            const phone = (u.phone || '').toLowerCase();
            return fName.includes(query) || lName.includes(query) || fullName.includes(query) || email.includes(query) || phone.includes(query);
        });

        currentUserPage = 1;
        renderUserTable();
    }

    function renderUserTable() {
        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = '';

        const totalUsers = filteredUsers.length;
        if (totalUsers === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-gray-400 text-xs">No users found matching your search. (Total loaded: ${rawUsersData.length})</td></tr>`;
            document.getElementById('paginationInfo').textContent = `Showing 0-0 of 0 users`;
            document.getElementById('prevPageBtn').disabled = true;
            document.getElementById('nextPageBtn').disabled = true;
            return;
        }

        const totalPages = Math.ceil(totalUsers / usersPerPage);
        if (currentUserPage > totalPages) currentUserPage = totalPages;
        if (currentUserPage < 1) currentUserPage = 1;

        const startIdx = (currentUserPage - 1) * usersPerPage;
        const endIdx = Math.min(startIdx + usersPerPage, totalUsers);
        const pageItems = filteredUsers.slice(startIdx, endIdx);

        pageItems.forEach(u => {
            const tr = document.createElement('tr');
            tr.className = "border-b border-gray-100 hover:bg-gray-50 transition text-xs";
            tr.innerHTML = `
                <td class="p-3 font-semibold text-gray-900">${escapeHtml(u.firstName || '-')}</td>
                <td class="p-3 font-semibold text-gray-900">${escapeHtml(u.lastName || '-')}</td>
                <td class="p-3 text-gray-600">${escapeHtml(u.email || '-')}</td>
                <td class="p-3 text-gray-600">${escapeHtml(u.phone || '-')}</td>
                <td class="p-3 text-center"><span class="bg-blue-50 text-blue-600 font-bold px-2 py-0.5 rounded-full">${u.reservationsCount || 0}</span></td>
                <td class="p-3 text-center"><span class="bg-purple-50 text-purple-600 font-bold px-2 py-0.5 rounded-full">${u.conversationsCount || 0}</span></td>
                <td class="p-3 text-right">
                    <form action="/admin/user/${u.id}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">
                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg font-semibold transition">Delete</button>
                    </form>
                </td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('paginationInfo').textContent = `Showing ${startIdx + 1}-${endIdx} of ${totalUsers} users (Page ${currentUserPage} of ${totalPages || 1})`;
        document.getElementById('prevPageBtn').disabled = currentUserPage === 1;
        document.getElementById('nextPageBtn').disabled = currentUserPage >= totalPages;
    }

    function changeUserPage(direction) {
        currentUserPage += direction;
        renderUserTable();
    }

    document.addEventListener("DOMContentLoaded", () => {
        renderUserTable();
    });

    function escapeHtml(str) {
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
</script>